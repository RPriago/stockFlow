PORT=8080

# Database Configuration:
# - For MongoDB Atlas: paste your Atlas connection string here, e.g.:
#   MONGO_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stockflow?retryWrites=true&w=majority"
# - For Local MongoDB: "mongodb://localhost:27017"
MONGO_URI=mongodb://localhost:27017
DB_NAME=stockflow

# Set to true to run in zero-dependency in-memory mode without MongoDB
USE_IN_MEMORY_DB=false

# JWT & Authentication
JWT_SECRET=super-secret-stockflow-jwt-token-key-change-in-prod-2026
JWT_EXPIRY_HOURS=24
COOKIE_DOMAIN=
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000

# Default Seed Super Admin
INITIAL_ADMIN_EMAIL=admin@stockflow.com
INITIAL_ADMIN_PASSWORD=Admin123!
INITIAL_ADMIN_NAME=System Super Admin
